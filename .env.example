# Copy to .env and replace required placeholders before starting Atlas.
GROQ_API_KEY=replace-with-your-groq-api-key
TAVILY_API_KEY=replace-with-your-tavily-api-key

# Development values only. Production requires a random SECRET_KEY of at least 32 characters
# and an explicit CORS_ALLOWED_ORIGINS list for the deployed frontend.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
FRONTEND_BASE_URL=http://localhost:5500

# Optional embedding key; Atlas uses a local sentence-transformer by default.
OPENAI_API_KEY=replace-if-needed

# Defaults to 1000 calls per account per day. The monthly spend cap is optional in development,
# but required in production. Token-based estimates are not guaranteed hard spend ceilings.
DEFAULT_DAILY_LLM_CALL_LIMIT=1000
# Uncomment and set a nonnegative USD amount before running with APP_ENV=production.
# DEFAULT_MONTHLY_LLM_SPEND_CAP_USD=25.00

# Storage overrides are optional; defaults are under backend/data.

# ── Multi-provider Compare (OpenAI, Anthropic, Google Gemini, xAI Grok) ───────────────────────────
# Server-side only: keys are never sent to the browser. Leave a provider blank to disable it.
# Placeholder values (dummy, your-key-here, ...) are treated as "not configured".
# OPENAI_API_KEY above is shared with embeddings; it must be a real key to enable OpenAI in Compare.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# Optional tuning (defaults shown). Costs are estimates from catalog prices, not provider invoices.
# COMPARE_MAX_COST_PER_REQUEST_USD=0.50     # a run whose worst-case estimate exceeds this is refused before any call
# PROVIDER_TIMEOUT_SECONDS=90               # per attempt
# PROVIDER_DEADLINE_SECONDS=170             # all attempts + backoff for one call
# PROVIDER_MAX_RETRIES=2
# COMPARE_RETENTION_DAYS=90                 # saved comparison runs are deleted after this many days
# MODEL_CATALOG_PATH=                       # custom catalog.json (model IDs / prices)
# COMPARE_EVAL_DIR=                         # where evaluation result files are read from
